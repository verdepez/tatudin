# ==============================================================================
# Tatudin - Variables de Entorno de Ejemplo
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL
# Reemplaza con los valores de tu instancia local o de producción
# Formato: postgres://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgres://tu_usuario:tu_contraseña@localhost:5432/tatudin_db

# Parámetros alternativos individuales (opcional, si no se usa DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=tu_usuario
# PGPASSWORD=tu_contraseña
# PGDATABASE=tatudin_db

# Servicio de Correo Transaccional (Opcional)
# Si se provee, se utiliza para recuperación de contraseñas y notificaciones
RESEND_API_KEY=
SMTP_FROM="Tatudin <no-reply@tatudin.cl>"
